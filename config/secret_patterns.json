{
  "_rule": "Регулярные выражения секретов. ignore_paths — glob от корня репозитория",
  "patterns": [
    {"id": "anthropic", "regex": "sk-ant-[A-Za-z0-9_\\-]{20,}"},
    {"id": "openrouter", "regex": "sk-or-v1-[A-Za-z0-9]{20,}"},
    {"id": "openai_like", "regex": "sk-(proj-)?[A-Za-z0-9]{32,}"},
    {"id": "aws_access_key", "regex": "AKIA[0-9A-Z]{16}"},
    {"id": "yandex_iam_or_api", "regex": "(AQVN|t1\\.)[A-Za-z0-9_\\-.]{30,}"},
    {"id": "github_token", "regex": "gh[pousr]_[A-Za-z0-9]{30,}"},
    {"id": "private_key", "regex": "-----BEGIN [A-Z ]*PRIVATE KEY-----"},
    {"id": "generic_assignment", "regex": "(?i)(api[_-]?key|secret|token|password|passwd)\\s*[:=]\\s*['\"]?[A-Za-z0-9_\\-]{20,}"}
  ],
  "ignore_paths": ["tests/fixtures/**", ".venv/**"]
}

{
  "protected_globs": [
    "CLAUDE.md",
    "AGENTS.md",
    ".claude/**",
    "knowledge/**",
    "config/**",
    "schemas/**",
    "strateg/**",
    "tests/**",
    "pyproject.toml",
    ".mcp.json"
  ],
  "state_globs": [
    "projects/*/state/*.jsonl",
    "projects/*/project.json"
  ],
  "log_skip_tools": [
    "Read",
    "Glob",
    "Grep",
    "LS",
    "TodoWrite"
  ],
  "bash_deny": [
    "rm\\s+-[a-zA-Z]*r[a-zA-Z]*\\s+.*projects",
    "git\\s+push\\s+.*(--force|-f\\b)",
    "git\\s+reset\\s+--hard"
  ],
  "no_project_text": "Активного проекта нет. Опиши задачу своими словами — я начну с постановки (навык novyi). Продолжить прежний: «продолжи <slug>»; список: python -m strateg project list",
  "bash_protected_rx": "(?:^|[\\s'\\\"=/])(?:CLAUDE\\.md|AGENTS\\.md|\\.claude/|knowledge/|config/|schemas/|tests/|pyproject\\.toml|\\.mcp\\.json|strateg/(?:cli|hooks|__main__|__init__)\\.py|strateg/(?:cmd|lib|route|report)/|projects/[^/\\s]+/(?:state/|project\\.json))",
  "bash_write_rx": "\\bsed\\b[^|;&]*\\s-i|\\bperl\\b[^|;&]*\\s-i|>{1,2}|\\btee\\b|\\bcp\\b|\\bmv\\b|\\brm\\b|\\btruncate\\b|\\bpatch\\b|write_text|write_bytes|\\.write\\(|open\\([^)]*['\\\"][wax]|os\\.replace|shutil\\.",
  "bash_neutral_rx": "\\d?>&\\d|\\d?>\\s*/dev/null|&>\\s*/dev/null"
}
